# Entorno (development, production)
NODE_ENV=development

# Puerto del servidor
PORT=5000

# Base de Datos
MONGODB_USERNAME=your_username
MONGODB_PASSWORD=your_password
MONGODB_URI=mongodb+srv:...

# Secretos JWT (Access y Refresh)
JWT_SECRET=super_secret_access_token_key_change_me
JWT_REFRESH_SECRET=super_secret_refresh_token_key_change_me

# Secreto para Cookie Parser
COOKIE_SECRET=super_secret_cookie_key_change_me

# URL del Frontend (CORS)
FRONTEND_URL=http://localhost:5173

# Cloudinary (Opcional por ahora)
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
